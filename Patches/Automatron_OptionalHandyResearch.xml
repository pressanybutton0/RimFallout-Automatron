            <tab>FalloutMech_Robotics</tab>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ResearchProjectDef[defName="RimFallout_AutomatronSentryEngineering"]/tab</xpath>
          <value>
            <tab>FalloutMech_Robotics</tab>
          </value>
        </li>
