<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseGunWithQuality">
    <defName>RimFallout_ProtectronsGaze</defName>
    <smeltable>false</smeltable>
    <label>Protectron's Gaze</label>
    <description>The Mechanist's personal laser pistol, capable of rapid, accurate fire. Its control module also helps a mechanitor command more mechs.\n\nWhile equipped, mech bandwidth: +3.</description>
    <techLevel>Spacer</techLevel>
    <tradeability>Sellable</tradeability>
    <destroyOnDrop>false</destroyOnDrop>
    <relicChance>0</relicChance>
    <recipeMaker IsNull="True" />
    <tradeTags Inherit="False" />
    <thingSetMakerTags Inherit="False" />
    <graphicData>
      <texPath>Things/Item/Equipment/Automatron/ProtectronsGaze</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>1100</MarketValue>
      <Mass>1.5</Mass>
      <RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
      <AccuracyTouch>0.60</AccuracyTouch>
      <AccuracyShort>0.69</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
    </statBases>
    <weaponTags>
      <li>RimFallout_IsabelSidearm</li>
    </weaponTags>
    <soundInteract>Interact_Revolver</soundInteract>
    <tools Inherit="False">
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>RimFallout_ProtectronsGazeBolt</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <range>23.9</range>
        <warmupTime>0.7</warmupTime>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>0.7</muzzleFlashScale>
      </li>
    </verbs>
    <equippedStatOffsets>
      <MechBandwidth>3</MechBandwidth>
    </equippedStatOffsets>
    <comps>
      <li Class="RimFallout.Automatron.CompProperties_GazeBandwidth" />
    </comps>
  </ThingDef>
