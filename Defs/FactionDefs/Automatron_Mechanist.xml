<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <FactionDef Name="RimFalloutMechanistRobotBase" ParentName="FactionBase">
    <defName>RimFallout_MechanistRobots</defName>
    <label>Automatron</label>
    <fixedName>Automatron</fixedName>
    <pawnSingular>mechanoid</pawnSingular>
    <pawnsPlural>mechanoids</pawnsPlural>
    <description>A robot army commanded by the Mechanist. It carries out orders to "protect civilians," leaving battlefields in its wake.</description>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <techLevel>Ultra</techLevel>
    <requiredMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Transhumanist</li>
    </requiredMemes>
    <autoFlee>false</autoFlee>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <canRequestTraders>false</canRequestTraders>
    <canRequestMilitaryAid>false</canRequestMilitaryAid>
    <factionIconPath>World/WorldObjects/Expanding/Mechanoids</factionIconPath>
    <generateNewLeaderFromMapMembersOnly>true</generateNewLeaderFromMapMembersOnly>
    <permanentEnemyToEveryoneExcept>
      <li>RimFallout_MechanistIsabel</li>
    </permanentEnemyToEveryoneExcept>
    <earliestRaidDays>45</earliestRaidDays>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300, 0)</li>
        <li>(700, 1)</li>
        <li>(1400, 1.8)</li>
        <li>(2800, 2.2)</li>
        <li>(4000, 2.6)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0, 220)</li>
        <li>(600, 220)</li>
        <li>(1000, 310)</li>
        <li>(2200, 500)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <RimFallout_Raid_RimFallout_Robobrain>5</RimFallout_Raid_RimFallout_Robobrain>
          <RimFallout_Raid_RimFallout_SentryBot>5</RimFallout_Raid_RimFallout_SentryBot>
          <RimFallout_Raid_Mech_MisterHandy_NexGen MayRequire="pressanybutton.MrHandy">1</RimFallout_Raid_Mech_MisterHandy_NexGen>
          <RimFallout_Raid_Mech_MisterGutsy MayRequire="pressanybutton.MrHandy">3</RimFallout_Raid_Mech_MisterGutsy>
          <RimFallout_Raid_Mech_MisterGutsyLieutenant MayRequire="pressanybutton.MrHandy">2</RimFallout_Raid_Mech_MisterGutsyLieutenant>
          <RimFallout_Raid_Mech_MisterGutsyColonel MayRequire="pressanybutton.MrHandy">0.5</RimFallout_Raid_Mech_MisterGutsyColonel>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
  <FactionDef ParentName="RimFalloutMechanistRobotBase">
    <defName>RimFallout_MechanistRobotsStopped</defName>
    <hidden>true</hidden>
    <description>The Mechanist network has been shut down. Its remaining robots no longer carry out attack orders.</description>
    <permanentEnemyToEveryoneExcept Inherit="False" IsNull="True" />
    <permanentEnemy>false</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <raidsForbidden>true</raidsForbidden>
  </FactionDef>
  <FactionDef ParentName="FactionBase">
    <defName>RimFallout_MechanistIsabel</defName>
    <label>Isabel Cruz</label>
    <fixedName>Isabel Cruz</fixedName>
    <description>Isabel Cruz, a robotics engineer who calls herself the Mechanist.</description>
    <humanlikeFaction>true</humanlikeFaction>
    <backstoryFilters>
      <li><categories><li>Offworld</li></categories></li>
    </backstoryFilters>
    <hidden>true</hidden>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <techLevel>Ultra</techLevel>
    <requiredMemes MayRequire="Ludeon.RimWorld.Ideology">
      <li>Transhumanist</li>
    </requiredMemes>
    <autoFlee>false</autoFlee>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <canRequestTraders>false</canRequestTraders>
    <canRequestMilitaryAid>false</canRequestMilitaryAid>
    <factionIconPath>World/WorldObjects/Expanding/Mechanoids</factionIconPath>
    <generateNewLeaderFromMapMembersOnly>true</generateNewLeaderFromMapMembersOnly>
    <raidsForbidden>true</raidsForbidden>
  </FactionDef>
</Defs>
