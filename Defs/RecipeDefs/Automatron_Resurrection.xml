<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef ParentName="BaseMechanoidResurrectionRecipe">
    <defName>RimFallout_ResurrectRobobrain</defName>
    <label>resurrect Robobrain</label>
    <description>Resurrect a friendly Robobrain. Requires that the mechanoid's body has not been completely destroyed.</description>
    <researchPrerequisite>RimFallout_AutomatronRobobrainEngineering</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Corpse_RimFallout_Robobrain</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_RimFallout_Robobrain</li>
      </thingDefs>
    </fixedIngredientFilter>
    <jobString>Resurrecting mechanoid.</jobString>
  </RecipeDef>
