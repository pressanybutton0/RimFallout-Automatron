<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <BodyDef>
    <defName>RimFallout_RobobrainBody</defName>
    <label>Robobrain chassis</label>
    <corePart>
      <def>MechanicalThorax</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>MechanicalHead</def>
          <coverage>0.12</coverage>
          <customLabel>brain dome</customLabel>
          <height>Top</height>
          <groups>
            <li>HeadAttackTool</li>
          </groups>
          <parts>
            <li>
              <def>SightSensor</def>
              <coverage>0.15</coverage>
            </li>
            <li>
              <def>HearingSensor</def>
              <coverage>0.1</coverage>
            </li>
            <li>
              <def>ArtificialBrain</def>
              <coverage>0.1</coverage>
              <customLabel>preserved brain</customLabel>
              <depth>Inside</depth>
            </li>
          </parts>
        </li>
        <li>
          <def>MechanicalArm</def>
          <coverage>0.12</coverage>
          <customLabel>left arm</customLabel>
          <parts>
            <li>
              <def>MechanicalHand</def>
              <coverage>0.2</coverage>
              <customLabel>left hand</customLabel>
            </li>
          </parts>
          <groups>
            <li>RimFallout_AutomatronGunArms</li>
          </groups>
        </li>
        <li>
          <def>MechanicalArm</def>
          <coverage>0.12</coverage>
          <customLabel>right arm</customLabel>
          <parts>
            <li>
              <def>MechanicalHand</def>
              <coverage>0.2</coverage>
              <customLabel>right hand</customLabel>
            </li>
          </parts>
          <groups>
            <li>RimFallout_AutomatronGunArms</li>
          </groups>
        </li>
        <li>
          <def>RimFallout_Track</def>
          <coverage>0.2</coverage>
          <customLabel>left track</customLabel>
          <height>Bottom</height>
        </li>
        <li>
          <def>RimFallout_Track</def>
          <coverage>0.2</coverage>
          <customLabel>right track</customLabel>
          <height>Bottom</height>
        </li>
        <li>
          <def>Reactor</def>
          <coverage>0.06</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>FluidReprocessor</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
      </parts>
    </corePart>
  </BodyDef>
